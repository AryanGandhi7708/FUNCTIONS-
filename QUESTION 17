#include <stdio.h>
float parkingfee(float hr){
    if (hr > 10) return (hr * 100);
    else return (hr * 85);
}
int main (){
    printf("If no of hr > 10, fee will be 100 per hr else 85\n");
    printf("Enter no of hr: ");
    float hr;
    scanf("%f", &hr);
    float fee = parkingfee(hr);
    printf("Parking fee is %.2f\n", fee);
    return 0;
}
